# --- Server ---
PORT=5000
NODE_ENV=development

# --- MongoDB ---
# Local:   mongodb://127.0.0.1:27017/kisaansetu
# Atlas:   mongodb+srv://<user>:<password>@<cluster>.mongodb.net/kisaansetu
MONGODB_URI=mongodb://127.0.0.1:27017/kisaansetu

# --- Auth ---
# Any long random string. Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace_this_with_a_long_random_string
OTP_HASH_SECRET=replace_this_with_another_long_random_string

# --- Razorpay ---
# Use the published test keys while developing:
# https://razorpay.com/docs/payments/payments/test-card-upi-details/
RAZORPAY_KEY_ID=rzp_test_1DP5mmOlF5G5ag
RAZORPAY_KEY_SECRET=replace_with_your_test_key_secret
